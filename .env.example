NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Python API uses these aliases; browser code must only receive the NEXT_PUBLIC values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Used to build email confirmation/recovery links; use your deployed HTTPS origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server only. Never add NEXT_PUBLIC_ to this key.
SUPABASE_SERVICE_ROLE_KEY=
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
# Python API URL used by the frontend and Next.js same-origin API proxy.
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000
# Configure a concrete payment adapter only after selecting a payment provider.
PAYMENT_PROVIDER=
# Optional signing key for 10-minute demo checkout links. Falls back to the server-only Supabase service key.
DEMO_PAYMENT_SECRET=
# Customer order email delivery (SMTP; sender address must be verified by your provider).
EMAIL_SMTP_HOST=smtp-relay.brevo.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=MODMYRIDE
